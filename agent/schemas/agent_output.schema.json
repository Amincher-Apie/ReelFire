{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reelfire.local/schemas/agent_output.schema.json",
  "title": "ReelFire Agent Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "status",
    "provider",
    "summary",
    "tags",
    "suggestions",
    "segment_comments",
    "review",
    "evidence_refs",
    "knowledge_refs",
    "trace",
    "errors"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "completed",
        "degraded",
        "failed"
      ]
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "model"
      ],
      "properties": {
        "type": {
          "enum": [
            "ollama",
            "dify",
            "coze",
            "rule_only"
          ]
        },
        "model": {
          "type": "string"
        },
        "request_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "summary": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "description",
          "evidence_refs"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "suggestion_id",
          "title",
          "action",
          "priority",
          "evidence_refs",
          "knowledge_refs"
        ],
        "properties": {
          "suggestion_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "knowledge_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "segment_comments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "segment_id",
          "title",
          "comment",
          "score_reason",
          "review_status",
          "action_recommendation",
          "explanation",
          "boundary_suggestion",
          "evidence_refs"
        ],
        "properties": {
          "segment_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "comment": {
            "type": "string",
            "minLength": 1
          },
          "score_reason": {
            "type": "string",
            "minLength": 1
          },
          "review_status": {
            "enum": [
              "pass",
              "needs_review",
              "reject"
            ]
          },
          "action_recommendation": {
            "enum": [
              "adopt",
              "needs_review",
              "reject"
            ]
          },
          "explanation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "highlight_type",
              "trigger_rule",
              "time_range",
              "detections",
              "keyframe_refs",
              "detection_box_refs"
            ],
            "properties": {
              "highlight_type": {
                "type": "string",
                "minLength": 1
              },
              "trigger_rule": {
                "type": "string",
                "minLength": 1
              },
              "time_range": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "start",
                  "end"
                ],
                "properties": {
                  "start": {
                    "type": "number",
                    "minimum": 0
                  },
                  "end": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              },
              "detections": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "class_name",
                    "track_id",
                    "first_seen",
                    "last_seen",
                    "observed_frame_count",
                    "consecutive_frame_count",
                    "average_confidence",
                    "max_confidence",
                    "evidence_refs"
                  ],
                  "properties": {
                    "class_name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "track_id": {
                      "type": [
                        "string",
                        "integer",
                        "null"
                      ]
                    },
                    "first_seen": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "last_seen": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "observed_frame_count": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "consecutive_frame_count": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "average_confidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "max_confidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "evidence_refs": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "keyframe_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "detection_box_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "boundary_suggestion": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "suggested_start",
              "suggested_end",
              "reason"
            ],
            "properties": {
              "action": {
                "enum": [
                  "keep",
                  "review_start",
                  "review_end",
                  "review_both",
                  "manual_review"
                ]
              },
              "suggested_start": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "suggested_end": {
                "type": [
                  "number",
                  "null"
                ],
                "exclusiveMinimum": 0
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recommendation",
        "confidence",
        "reasons"
      ],
      "properties": {
        "recommendation": {
          "enum": [
            "pass",
            "needs_review",
            "reject"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref_id",
          "type",
          "source_id"
        ],
        "properties": {
          "ref_id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "detection",
              "score",
              "keyframe",
              "segment",
              "report"
            ]
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "timestamp": {
            "type": "number",
            "minimum": 0
          },
          "class_name": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "value": {}
        }
      }
    },
    "knowledge_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "knowledge_id",
          "category",
          "title"
        ],
        "properties": {
          "knowledge_id": {
            "type": "string",
            "pattern": "^KB-[A-Z]+-[0-9]{3}$"
          },
          "category": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started_at",
        "finished_at",
        "duration_ms",
        "degraded",
        "tools"
      ],
      "properties": {
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "degraded": {
          "type": "boolean"
        },
        "input_summary_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "status",
              "duration_ms"
            ],
            "properties": {
              "name": {
                "enum": [
                  "report_parser",
                  "knowledge_retriever",
                  "advice_generator",
                  "rule_validator"
                ]
              },
              "status": {
                "enum": [
                  "completed",
                  "degraded",
                  "failed",
                  "skipped"
                ]
              },
              "duration_ms": {
                "type": "integer",
                "minimum": 0
              },
              "input_summary": {
                "type": "string"
              },
              "output_summary": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "stage",
          "retryable"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "stage": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "provider_code": {
            "type": "string"
          },
          "attempt_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
