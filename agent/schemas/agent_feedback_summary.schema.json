{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reelfire.local/schemas/agent_feedback_summary.schema.json",
  "title": "ReelFire Agent Feedback Summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "event_count",
    "candidate_count",
    "decision_counts",
    "adoption_rate",
    "common_rejection_reasons",
    "boundary_adjustments",
    "order_changes",
    "reexports",
    "rule_optimization_suggestions",
    "trace"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "enum": [
        "completed",
        "needs_more_data"
      ]
    },
    "event_count": {
      "type": "integer",
      "minimum": 0
    },
    "candidate_count": {
      "type": "integer",
      "minimum": 0
    },
    "decision_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adopted",
        "needs_review",
        "rejected"
      ],
      "properties": {
        "adopted": {"type": "integer", "minimum": 0},
        "needs_review": {"type": "integer", "minimum": 0},
        "rejected": {"type": "integer", "minimum": 0}
      }
    },
    "adoption_rate": {
      "$ref": "#/$defs/rate"
    },
    "common_rejection_reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reason", "count", "rate_among_rejections"],
        "properties": {
          "reason": {"type": "string", "minLength": 1},
          "count": {"type": "integer", "minimum": 1},
          "rate_among_rejections": {"$ref": "#/$defs/rate"}
        }
      }
    },
    "boundary_adjustments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adjusted_count",
        "adjustment_rate",
        "average_start_delta_seconds",
        "average_end_delta_seconds",
        "average_absolute_change_seconds"
      ],
      "properties": {
        "adjusted_count": {"type": "integer", "minimum": 0},
        "adjustment_rate": {"$ref": "#/$defs/rate"},
        "average_start_delta_seconds": {"type": "number"},
        "average_end_delta_seconds": {"type": "number"},
        "average_absolute_change_seconds": {"type": "number", "minimum": 0}
      }
    },
    "order_changes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changed_count", "change_rate"],
      "properties": {
        "changed_count": {"type": "integer", "minimum": 0},
        "change_rate": {"$ref": "#/$defs/rate"}
      }
    },
    "reexports": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "rate"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "rate": {"$ref": "#/$defs/rate"}
      }
    },
    "rule_optimization_suggestions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["suggestion_id", "title", "action", "basis", "priority"],
        "properties": {
          "suggestion_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1},
          "basis": {"type": "string", "minLength": 1},
          "priority": {"enum": ["high", "medium", "low"]}
        }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "status",
        "duration_ms",
        "source_event_count",
        "latest_candidate_count"
      ],
      "properties": {
        "tool": {"const": "feedback_analyzer"},
        "status": {"const": "completed"},
        "duration_ms": {"type": "integer", "minimum": 0},
        "source_event_count": {"type": "integer", "minimum": 0},
        "latest_candidate_count": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
