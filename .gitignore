# Python
__pycache__/
*.py[cod]
.pytest_cache/
.coverage

# Local environments and secrets
.venv/
venv/
.env
.env.*

# IDE and OS files
.idea/
.vscode/
node_modules/
.DS_Store
Thumbs.db

# Runtime data and generated media
outputs/*
!outputs/.gitkeep
*.log
*.mp4
*.avi
*.mov
*.mkv

# Large model artifacts are delivered separately unless Git LFS is configured
# 课设要求提交模型权重或下载说明，因此保留 models/*.pt 可提交
# 如需排除特定大文件，使用 .gitattributes 或 Git LFS
models/*.onnx
models/*.engine

# 安装包和误下载的文件
*.whl
yolo26n.pt

# 训练中间产物：只保留必要文件（best.pt + results.png + args.yaml）
runs/detect/custom_fps/
runs/detect/custom_fps_v2/
runs/detect/custom_fps_v4/
runs/detect/val/
