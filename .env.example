# Copy this file to .env and fill values only on the machine running ReelFire.
# Never commit a real key. An empty DIFY_API_KEY causes a safe rule fallback.

AGENT_PROVIDER=dify
DIFY_BASE_URL=https://api.dify.ai
DIFY_API_KEY=
DIFY_USER=reelfire-demo
DIFY_MODEL_LABEL=dify-chat-app

# Optional local Embedding and offline generation fallback.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
OLLAMA_MODEL=qwen3:0.6b
