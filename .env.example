# Copy this file to .env and fill values only on the machine running ReelFire.
# Dify contract: Cloud + Chatflow (advanced-chat) + blocking /chat-messages.
# Never commit a real key. An empty DIFY_API_KEY causes a safe rule fallback.

AGENT_PROVIDER=dify
DIFY_BASE_URL=https://api.dify.ai
DIFY_API_KEY=
DIFY_USER=reelfire-demo
DIFY_MODEL_LABEL=reelfire-chatflow-v1.0.0
DIFY_MAX_ATTEMPTS=3
DIFY_RETRY_BASE_SECONDS=0.5

# Portable knowledge-base Embedding. Team deployments should use the same
# OpenAI-compatible API/model on every machine. Keep the real key in .env only.
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_TIMEOUT_SECONDS=30

# Local Ollama is opt-in: set EMBEDDING_PROVIDER=ollama on that machine.
# Never select it implicitly because installed models differ across computers.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
OLLAMA_MODEL=qwen3:0.6b
